POSTGRES_DB=scaner
POSTGRES_USER=scaner_app
# Required. Generate a URL-safe password with openssl rand -hex 24.
POSTGRES_PASSWORD=
# For app commands and tests run on the host, export a DATABASE_URL using localhost:5432.
# Optional. Without it GitHub allows 60 requests/hour/IP.
GITHUB_TOKEN=
# Optional. Without a key the report uses template explanations (it is complete either way).
# Providers: anthropic (only one implemented; see src/adapters/llm/registry.ts).
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Defaults to the provider's default model (anthropic: claude-opus-5-5).
LLM_MODEL=
LLM_TIMEOUT_MS=20000
# Admission control (API): per-client POST /scans per minute; max scans queued/running at once.
SUBMIT_RATE_PER_MINUTE=10
MAX_OUTSTANDING_SCANS=200
# Only behind a proxy you control: take the client IP from X-Forwarded-For.
TRUST_PROXY=false
# Retention (worker): delete finished scans after N days, idempotency keys after N hours.
SCAN_RETENTION_DAYS=30
IDEMPOTENCY_KEY_TTL_HOURS=24
