POSTGRES_DB=scaner
POSTGRES_USER=scaner_app
# Required. Generate a URL-safe password with openssl rand -hex 24.
POSTGRES_PASSWORD=
# For app commands and tests run on the host, export a DATABASE_URL using localhost:5432.
# Optional, public scans only. Without it GitHub allows 60 requests/hour/IP. Must NOT be able to read private
# repositories (use a fine-grained token with public repositories, read-only): the worker checks at startup and
# ignores any token that can.
GITHUB_TOKEN=
# Optional: GitHub sign-in and private repositories (README "Private repositories"). Set all of them or none.
# API: client id + secret, the app's URL name, a session secret (openssl rand -hex 32) and the public origin
# (https, or http://localhost:3000 locally). Worker: client id + private key (PEM; \n escapes are fine).
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
SESSION_SECRET=
PUBLIC_URL=
# Optional. Without a key the report uses template explanations (it is complete either way).
# Providers: anthropic (only one implemented; see src/adapters/llm/registry.ts).
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Defaults to the provider's default model (anthropic: claude-opus-5-5).
LLM_MODEL=
LLM_TIMEOUT_MS=20000
# Admission control (API): per-client POST /scans per minute; max scans queued/running at once.
SUBMIT_RATE_PER_MINUTE=10
MAX_OUTSTANDING_SCANS=200
# Only behind a proxy you control: take the client IP from X-Forwarded-For.
TRUST_PROXY=false
# Source checks (worker): files read per scan, bytes per file, total bytes. Defaults shown.
SOURCE_MAX_FILES=200
SOURCE_MAX_FILE_BYTES=262144
SOURCE_MAX_TOTAL_BYTES=10485760
# Retention (worker): delete finished scans after N days, idempotency keys after N hours.
SCAN_RETENTION_DAYS=30
IDEMPOTENCY_KEY_TTL_HOURS=24
