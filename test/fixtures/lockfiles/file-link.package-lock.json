{
  "name": "app",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "app",
      "version": "1.0.0",
      "workspaces": [
        "packages/*"
      ],
      "dependencies": {
        "@x/ws": "*",
        "local-lib": "file:../local"
      }
    },
    "../local": {
      "name": "local-lib",
      "version": "2.0.0",
      "dependencies": {
        "ms": "2.1.3"
      }
    },
    "node_modules/@x/ws": {
      "resolved": "packages/ws",
      "link": true
    },
    "node_modules/local-lib": {
      "resolved": "../local",
      "link": true
    },
    "packages/ws": {
      "name": "@x/ws",
      "version": "0.1.0"
    }
  }
}
