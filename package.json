{
  "name": "ai-scan-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "preapi": "node scripts/check-node.mjs",
    "api": "node src/api/main.ts",
    "preworker": "node scripts/check-node.mjs",
    "worker": "node src/worker/main.ts",
    "premigrate": "node scripts/check-node.mjs",
    "migrate": "node scripts/migrate.ts",
    "build:web": "node scripts/build-web.ts",
    "pretest": "node scripts/check-node.mjs",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/web",
    "preeval": "node scripts/check-node.mjs",
    "eval": "node scripts/eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "pg-boss": "12.38.1",
    "semver": "7.8.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/semver": "7.8.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "msw": "3.0.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
